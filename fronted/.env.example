# Leave as /api/v1 for the local Vite proxy to http://localhost:4000.
# Production builds require the absolute backend API URL, e.g. https://api.example.com/api/v1.
# Keep frontend and API on the same site (for example app.example.com and api.example.com)
# so the Secure, SameSite=Lax authentication cookie is sent by browsers.
VITE_API_URL=/api/v1
