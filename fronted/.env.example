# Use /api/v1 with the local Vite proxy or a same-origin production reverse proxy.
# For a separate production API origin, use its HTTPS URL, e.g. https://api.example.com/api/v1.
# Keep frontend and API on the same site (for example app.example.com and api.example.com)
# so the Secure, SameSite=Lax authentication cookie is sent by browsers.
VITE_API_URL=/api/v1
