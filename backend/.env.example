NODE_ENV=development
PORT=4000
# MONGODB_URI is the existing setting; MONGO_URI is accepted as an alias.
MONGODB_URI=mongodb://127.0.0.1:27017/devhub
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated exact frontend origins; localhost:<PORT> is also allowed outside production.
# Production requires explicit origins here; do not use '*'.
# Vite's default frontend origin; additional exact origins can be comma-separated.
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:4000
# Dedicated test database only. Use a database name containing "test".
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/devhub_test
