doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title DevHub | Dashboard

        style.
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #111827;
                color: #ffffff;
            }

            nav {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 18px 40px;
                background: #1f2937;
                border-bottom: 1px solid #374151;
            }

            nav h2 {
                margin: 0;
            }

            nav a {
                color: white;
                text-decoration: none;
                margin-left: 20px;
            }

            nav a:hover {
                color: #60a5fa;
            }

            .container {
                width: 90%;
                max-width: 1200px;
                margin: 40px auto;
            }

            .welcome {
                margin-bottom: 30px;
            }

            .welcome h1 {
                margin-bottom: 8px;
            }

            .welcome p {
                color: #9ca3af;
            }

            .stats {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
                margin-bottom: 40px;
            }

            .card {
                background: #1f2937;
                padding: 22px;
                border-radius: 10px;
                border: 1px solid #374151;
            }

            .card h3 {
                margin-top: 0;
                color: #9ca3af;
                font-size: 15px;
            }

            .card strong {
                font-size: 30px;
                color: #60a5fa;
            }

            .section {
                background: #1f2937;
                padding: 25px;
                border-radius: 10px;
                margin-bottom: 25px;
                border: 1px solid #374151;
            }

            .section h2 {
                margin-top: 0;
            }

            .activity {
                padding: 12px 0;
                border-bottom: 1px solid #374151;
            }

            .activity:last-child {
                border-bottom: none;
            }

            .quick-actions a {
                display: inline-block;
                padding: 10px 18px;
                margin: 5px 10px 5px 0;
                background: #2563eb;
                color: white;
                text-decoration: none;
                border-radius: 6px;
            }

            .quick-actions a:hover {
                background: #1d4ed8;
            }

    body

        nav
            h2 DevHub

            div
                a(href="/") Home
                a(href="/questions") Questions
                a(href="/blogs") Blogs
                a(href="/community") Community
                a(href="/profile") Profile
                a(href="/logout") Logout

        .container

            .welcome
                if user
                    h1 Welcome, #{user.name}
                    p @#{user.username}
                else
                    h1 Welcome to DevHub
                    p Your developer dashboard

            .stats

                .card
                    h3 Reputation
                    if user
                        strong= user.reputation || 0
                    else
                        strong 0

                .card
                    h3 Questions
                    strong 0

                .card
                    h3 Answers
                    strong 0

                .card
                    h3 Blogs
                    strong 0

                .card
                    h3 Problems Solved
                    strong 0

            .section
                h2 Quick Actions

                .quick-actions
                    a(href="/ask-question") Ask Question
                    a(href="/create-blog") Write Blog
                    a(href="/coding") Practice Coding
                    a(href="/community") Open Community

            .section
                h2 Recent Activity

                .activity
                    p No recent questions yet.

                .activity
                    p No recent answers yet.

                .activity
                    p No blogs published yet.

            .section
                h2 Your Skills

                if user && user.skills && user.skills.length > 0
                    each skill in user.skills
                        span(style="margin-right:10px; color:#60a5fa;") ##{skill}
                else
                    p No skills added yet.